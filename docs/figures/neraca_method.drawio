<mxfile host="repeat-neraca"><diagram id="neraca" name="Neraca air method"><mxGraphModel dx="1600" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1320" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Neraca air, RE-PEAT: method adopted 2026-10-26 (repeat-neraca 0.1.0)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Any KHG, one command:&lt;/b&gt; repeat-neraca-batch --selected | --khg &amp;lt;codes&amp;gt; | --all (865 KHG of khg_registry.csv). Per KHG: work folder _khg/&amp;lt;code&amp;gt;_&amp;lt;name&amp;gt;/; steps 1-2 below; a KHG without sub-KHG units runs as one unit (--whole-khg). Fetches cached per year; summary _khg/neraca_balance_summary.csv." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c4" value="INPUTS" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="88" width="340" height="24" as="geometry"/></mxCell><mxCell id="c5" value="PROCESSING" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="88" width="340" height="24" as="geometry"/></mxCell><mxCell id="c6" value="OUTPUTS  (_khg/&amp;lt;khg&amp;gt;/03_neraca/)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="88" width="340" height="24" as="geometry"/></mxCell><mxCell id="c7" value="USED BY" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="88" width="250" height="24" as="geometry"/></mxCell><mxCell id="c8" value="A. Sub-KHG level: climatic water balance (formula and parameters of the 2021 Kahayan-Sebangau study)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="115" width="1510" height="490" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Sub-KHG units&lt;/b&gt; 02_delineation/subkhg_units.gpkg (repeat-delineation)&lt;br&gt;none yet: KHG boundary from batas_khg_indonesia.gpkg as one unit" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="145" width="340" height="52" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Rain P: CHIRPS daily&lt;/b&gt;&lt;br&gt;0.05° (5.6 km), 1981 to 2026-09-30, public domain&lt;br&gt;used as the &lt;b&gt;KHG mean&lt;/b&gt; for every unit" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="205" width="340" height="62" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;ET (central): MODIS MOD16A2GF&lt;/b&gt;&lt;br&gt;500 m, 8-day sum ×0.1, fill codes masked&lt;br&gt;2000 to 2025-12; level within eddy-covariance range" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="275" width="340" height="62" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ET (second source): WaPOR v3 L1 AETI&lt;/b&gt;&lt;br&gt;326 m, dekadal mean mm/day ×0.1, 2018 to 2026-10-11&lt;br&gt;20-30 % below eddy covariance" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="340" height="62" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Land cover: ESA WorldCover v200&lt;/b&gt; 10 m, 2021, CC-BY-4.0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="415" width="340" height="52" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Checks only:&lt;/b&gt; IMERG Final monthly (rain reference), TerraClimate (2021 reproduction)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="475" width="340" height="52" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;1. repeat_common.fetch_gee_balance&lt;/b&gt; (Earth Engine, EE_PROJECT)&lt;br&gt;• dekads 1-10, 11-20, 21-end&lt;br&gt;• period total = Σ images (daily rate × overlap days)&lt;br&gt;• mean per unit on each product's own grid, no resampling; valid pixels, time coverage&lt;br&gt;• WorldCover shares per unit, counted in 0.1° pieces&lt;br&gt;• one request per year, cached; provenance .json" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="205" width="400" height="132" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;2. repeat_neraca.balance&lt;/b&gt;&lt;br&gt;• dekads → months (fully covered months only); complete years&lt;br&gt;• &lt;b&gt;WB = P (1 − I) (1 − C) − ET&lt;/b&gt;, I = Σ share&lt;sub&gt;class&lt;/sub&gt; × I&lt;sub&gt;class&lt;/sub&gt;&lt;br&gt;• u_wb_mean, u_deficit_months; also P − ET (water signal between units)&lt;br&gt;• &lt;b&gt;balance_stable_ok&lt;/b&gt;: MOD16 and WaPOR agree on the order of ET, and the order holds between years, each above the p &amp;lt; 0.01 random-order level" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="355" width="400" height="142" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Parameters&lt;/b&gt; (repeat_neraca/parameters.yaml; B.K. Cahyono, established)&lt;br&gt;C = 0.12 · I: tree, mangrove 0.164 · shrub 0.08 · herbaceous wetland 0.05 · grass, crop 0.03 · other 0&lt;br&gt;stability: 99th percentile of a random order (0.43 for 30 units, 0.58 for 16)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f3f3f3;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="507" width="400" height="88" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;inputs/&lt;/b&gt; (or inputs/khg_level/)&lt;br&gt;balance_&amp;lt;product&amp;gt;_dekad.csv: unit_id, start, end, days, mm, n_px, time_cov (+ .json provenance)&lt;br&gt;units_landcover.csv: area_km2, wc_&amp;lt;class&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="205" width="330" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;runs/balance/&lt;/b&gt; (or runs/balance_khg_level/)&lt;br&gt;neraca_balance_unit.csv: &lt;b&gt;u_wb_mean&lt;/b&gt; (mm/month), &lt;b&gt;u_deficit_months&lt;/b&gt; (per year), &lt;b&gt;p_minus_et_mean_mm&lt;/b&gt;, wb_year_sd_mm, interception_share, n_px_*, balance_stable_ok&lt;br&gt;neraca_balance_monthly.csv · neraca_balance.md (calendar, ET order, forest share) · registry_snapshot.json" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="355" width="330" height="142" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;repeat-prioritisation&lt;/b&gt; (C5)&lt;br&gt;rank-sum water slot = P − ET; u_deficit_months not ranked (follows land cover); empty where balance_stable_ok = 0; need-score weight 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5ecf7;strokeColor=#8a5a9c;" vertex="1" parent="1"><mxGeometry x="1260" y="355" width="250" height="122" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c9" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c18" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;dashed=1;" edge="1" parent="1" source="c17" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="B. KHG level: supply deficit (mass balance on observed water tables)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="620" width="1510" height="250" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Water table: SiTMAT stations&lt;/b&gt;&lt;br&gt;repeat-sitmat/sitmat_out/processed (SITMAT_PROCESSED)&lt;br&gt;concession stations, 2026-04-01 to 2026-10-22 only" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="340" height="62" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Rain and evaporation: ERA5 daily&lt;/b&gt;&lt;br&gt;repeat_common.forcing (cache) or forcing_daily.csv&lt;br&gt;E within −6 to +2 % of MOD16; rain as close to IMERG as CHIRPS" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="340" height="62" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;KHG boundary&lt;/b&gt; 00_inputs/khg.gpkg" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="340" height="40" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;3. repeat-neraca-stations&lt;/b&gt; (site config neraca.yaml)&lt;br&gt;stations inside the KHG, ≥ 50 % of window days" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="650" width="400" height="52" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;4. deficit.py&lt;/b&gt; (repeat-neraca-run)&lt;br&gt;&lt;b&gt;deficit = max(0, −Σ(P − E) − Sy · Δz&lt;sub&gt;obs&lt;/sub&gt;)&lt;/b&gt;, 1 June to last forcing day (≤ 31 Oct)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="715" width="400" height="70" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Parameters&lt;/b&gt;: Sy 0.15 (band 0.10-0.20) · ERA5 P and E · Δz from first and last 7 days" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f3f3f3;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="795" width="400" height="52" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;inputs/&lt;/b&gt; stations.csv, stations_daily.csv (depth_cm, positive down)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="330" height="62" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;runs/deficit/neraca_khg.csv&lt;/b&gt;: deficit_mm (low, high), deficit_m3, deficit_months, n_stations" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="725" width="330" height="70" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;repeat-pump&lt;/b&gt; (subkhg_priority.csv deficit_mm), prioritisation report" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5ecf7;strokeColor=#8a5a9c;" vertex="1" parent="1"><mxGeometry x="1260" y="725" width="250" height="70" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c32" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c35" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c38" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c33" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c36" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;dashed=1;" edge="1" parent="1" source="c37" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="C. Diagnostic only (not on the ranking path)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="885" width="1510" height="95" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Physical model&lt;/b&gt;, tiers 1 and 2 (groundwater/lumped.py, groundwater/spatial.py): Sy(z) dz/dt = R − C(z)(z − z&lt;sub&gt;c&lt;/sub&gt;) and 2D Boussinesq; DTM, peat depth, canals by class. Explains why observed water tables are held (supply from outside the rain balance); per-sub-KHG skill 0, frozen." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f7f7f7;strokeColor=#aaaaaa;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="915" width="790" height="55" as="geometry"/></mxCell><mxCell id="c51" value="Retired 2026-10-26: bucket model fitted to SiTMAT (failed spatial skill check); record in docs/bucket_reports/. Not used: TerraClimate (ends 2024-12), runoff C 0.25 / 0.35 of the 2021 scripts." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f7f7f7;strokeColor=#aaaaaa;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="915" width="610" height="55" as="geometry"/></mxCell><mxCell id="c52" value="D. What was added to the 2021 Earth Engine method (B.K. Cahyono, Kahayan-Sebangau, users/bambangkun/NDVI_DenganSentinel2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="995" width="1510" height="300" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;2021 method (kept: formula, C, interception)&lt;/b&gt;&lt;br&gt;• WB = pr − aet/10 − C·pr, monthly&lt;br&gt;• TerraClimate rain and AET (4.6 km), 2010-2020&lt;br&gt;• C = 0.25 placeholder (0.35 for ten units in one script); team value C = 0.12 and interception by land cover from the same study&lt;br&gt;• charts and maps in the Code Editor, one KHG&lt;br&gt;• 16 sub-KHG drawn by hand&lt;br&gt;• no check against observations" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fdf3e7;strokeColor=#b07a2a;" vertex="1" parent="1"><mxGeometry x="30" y="1025" width="470" height="260" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Added in repeat-neraca&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Data:&lt;/b&gt; CHIRPS rain (5.6 km, to 2026-09), MOD16 and WaPOR ET (500 m, 326 m), WorldCover interception shares; dekadal; native grids, pixel and time coverage per value; provenance per fetch&lt;br&gt;• &lt;b&gt;Rain as KHG mean:&lt;/b&gt; CHIRPS and IMERG disagree on which sub-KHG are wetter (Spearman −0.34, −0.06)&lt;br&gt;• &lt;b&gt;Central ET MOD16:&lt;/b&gt; 1,385-1,490 mm/yr against eddy covariance 1,374-1,636 (Hirano et al. 2015) and 1,579 (Tang et al. 2019); WaPOR and TerraClimate 1,100-1,260&lt;br&gt;• &lt;b&gt;Stability test&lt;/b&gt; against a random order (p &amp;lt; 0.01): ET products must agree on the order of ET; years must keep the order&lt;br&gt;• &lt;b&gt;Ranking signal P − ET:&lt;/b&gt; u_wb_mean follows forest share through the fixed interception term (Spearman −0.44 to −0.82)&lt;br&gt;• &lt;b&gt;KHG deficit&lt;/b&gt; on SiTMAT stations (water supplied from outside the rain balance) and the KHG calendar of deficit months&lt;br&gt;• &lt;b&gt;Checks:&lt;/b&gt; 2021 reproduced within 0.1 mm; Pulau Padang deficit months match Amal (2022); per-unit deficit on stations&lt;br&gt;• &lt;b&gt;Package and scale:&lt;/b&gt; any KHG from its code, batch over the registry, tests, clean-install check" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e9f3fb;strokeColor=#2f6f9f;" vertex="1" parent="1"><mxGeometry x="520" y="1025" width="990" height="260" as="geometry"/></mxCell><mxCell id="c55" value="extended" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

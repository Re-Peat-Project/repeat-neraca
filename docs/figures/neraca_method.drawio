<mxfile host="repeat-neraca"><diagram id="neraca" name="Neraca air method"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="980" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Neraca air, RE-PEAT: method adopted 2026-10-26 (repeat-neraca)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Any KHG, one command:&lt;/b&gt; python -m repeat_neraca.batch --selected | --khg &amp;lt;codes&amp;gt; | --all (865 KHG of khg_registry.csv). Per KHG: work folder _khg/&amp;lt;code&amp;gt;_&amp;lt;name&amp;gt;/; steps 1-2 below; a KHG without sub-KHG units runs as one unit (--whole-khg). Fetches cached per year; summary _khg/neraca_balance_summary.csv." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c4" value="INPUTS" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="88" width="340" height="24" as="geometry"/></mxCell><mxCell id="c5" value="PROCESSING" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="88" width="340" height="24" as="geometry"/></mxCell><mxCell id="c6" value="OUTPUTS  (_khg/&amp;lt;khg&amp;gt;/03_neraca/)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="88" width="340" height="24" as="geometry"/></mxCell><mxCell id="c7" value="USED BY" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="88" width="250" height="24" as="geometry"/></mxCell><mxCell id="c8" value="A. Sub-KHG level: climatic water balance (method of the 2021 Kahayan-Sebangau study)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="115" width="1510" height="470" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Sub-KHG units&lt;/b&gt; 02_delineation/subkhg_units.gpkg (repeat-delineation)&lt;br&gt;none yet: KHG boundary from batas_khg_indonesia.gpkg as one unit" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="145" width="340" height="52" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Rain P: CHIRPS daily&lt;/b&gt;&lt;br&gt;UCSB-CHG/CHIRPS/DAILY, 0.05° (5.6 km), mm/day&lt;br&gt;1981 to 2026-09-30, public domain" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="205" width="340" height="62" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;ET (central): WaPOR v3 L1 AETI&lt;/b&gt;&lt;br&gt;FAO/WAPOR/3/L1_AETI_D, 326 m, dekadal mean mm/day ×0.1&lt;br&gt;2018 to 2026-10-11; includes interception" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="275" width="340" height="62" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ET (second source): MODIS MOD16A2GF&lt;/b&gt;&lt;br&gt;500 m, 8-day sum ×0.1, fill codes masked&lt;br&gt;2000 to 2025-12, no use restrictions" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="340" height="62" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Land cover: ESA WorldCover v200&lt;/b&gt;&lt;br&gt;10 m, 2021, CC-BY-4.0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="415" width="340" height="52" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;1. repeat_common.fetch_gee_balance&lt;/b&gt; (Earth Engine, EE_PROJECT)&lt;br&gt;• dekads 1-10, 11-20, 21-end&lt;br&gt;• period total = Σ images (daily rate × overlap days)&lt;br&gt;• mean per unit on each product's own grid, no resampling; valid pixels, time coverage&lt;br&gt;• WorldCover shares per unit, counted in 0.1° pieces&lt;br&gt;• one request per year, cached; provenance .json" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="205" width="400" height="132" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;2. repeat_neraca.balance&lt;/b&gt;&lt;br&gt;• dekads → months (fully covered months only)&lt;br&gt;• &lt;b&gt;WB = P (1 − I) (1 − C) − ET&lt;/b&gt;, I = Σ share&lt;sub&gt;class&lt;/sub&gt; × I&lt;sub&gt;class&lt;/sub&gt;&lt;br&gt;• complete years only (all 12 months)&lt;br&gt;• indicators per unit; Spearman between years and between ET sources → balance_stable_ok" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="355" width="400" height="122" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Parameters&lt;/b&gt; (config/parameters.yaml; B.K. Cahyono, established)&lt;br&gt;C = 0.12 · I: tree, mangrove 0.164 · shrub 0.08 · herbaceous wetland 0.05 · grass, crop 0.03 · other 0&lt;br&gt;stability threshold Spearman 0.5 (provisional)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f3f3f3;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="487" width="400" height="88" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;inputs/&lt;/b&gt; (or inputs/khg_level/)&lt;br&gt;balance_&amp;lt;product&amp;gt;_dekad.csv: unit_id, start, end, days, mm, n_px, time_cov (+ .json provenance)&lt;br&gt;units_landcover.csv: area_km2, wc_&amp;lt;class&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="205" width="330" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;runs/balance/&lt;/b&gt; (or runs/balance_khg_level/)&lt;br&gt;neraca_balance_unit.csv: &lt;b&gt;u_wb_mean&lt;/b&gt; (mm/month), &lt;b&gt;u_deficit_months&lt;/b&gt; (per year), wb_year_sd_mm, p_minus_et_mean_mm, interception_share, n_px_*, balance_stable_ok&lt;br&gt;neraca_balance_monthly.csv · neraca_balance.md · registry_snapshot.json" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="355" width="330" height="132" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;repeat-prioritisation&lt;/b&gt;&lt;br&gt;extra_indicators (C5): replaces its TerraClimate balance, fills the rank-sum water slots; empty where balance_stable_ok = 0; need-score weight 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5ecf7;strokeColor=#8a5a9c;" vertex="1" parent="1"><mxGeometry x="1260" y="355" width="250" height="92" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c9" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c17" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;dashed=1;" edge="1" parent="1" source="c16" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="B. KHG level: supply deficit (mass balance on observed water tables)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="600" width="1510" height="250" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Water table: SiTMAT stations&lt;/b&gt;&lt;br&gt;repeat-sitmat/sitmat_out/processed (SITMAT_PROCESSED)&lt;br&gt;concession stations, 2026-04-01 to 2026-10-22 only" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="630" width="340" height="62" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Rain and evaporation: ERA5 daily&lt;/b&gt;&lt;br&gt;repeat_common.forcing (cache) or forcing_daily.csv&lt;br&gt;KHG mean, local days (WIB)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="340" height="62" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;KHG boundary&lt;/b&gt; 00_inputs/khg.gpkg" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#eef3fb;strokeColor=#5b7db8;" vertex="1" parent="1"><mxGeometry x="30" y="770" width="340" height="40" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;3. repeat_neraca.stations&lt;/b&gt; (site config neraca.yaml)&lt;br&gt;stations inside the KHG, ≥ 50 % of window days" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="630" width="400" height="52" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;4. deficit.py&lt;/b&gt; (scripts/run_neraca.py)&lt;br&gt;&lt;b&gt;deficit = max(0, −Σ(P − E) − Sy · Δz&lt;sub&gt;obs&lt;/sub&gt;)&lt;/b&gt;, 1 June to last forcing day (≤ 31 Oct)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#fff4e0;strokeColor=#c98a1b;" vertex="1" parent="1"><mxGeometry x="420" y="695" width="400" height="70" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Parameters&lt;/b&gt;: Sy 0.15 (band 0.10-0.20) · ERA5 central, WaPOR bound · Δz from first and last 7 days" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f3f3f3;strokeColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="775" width="400" height="52" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;inputs/&lt;/b&gt; stations.csv, stations_daily.csv (depth_cm, positive down)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="630" width="330" height="62" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;runs/&amp;lt;run&amp;gt;/neraca_khg.csv&lt;/b&gt;: deficit_mm (low, high), deficit_m3, deficit_months, n_stations" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#e8f5ea;strokeColor=#3f8f50;" vertex="1" parent="1"><mxGeometry x="900" y="705" width="330" height="70" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;repeat-pump&lt;/b&gt; (subkhg_priority.csv deficit_mm), prioritisation report" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5ecf7;strokeColor=#8a5a9c;" vertex="1" parent="1"><mxGeometry x="1260" y="705" width="250" height="70" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c31" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c34" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c37" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c32" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c35" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;dashed=1;" edge="1" parent="1" source="c36" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5f6b7a;fontSize=10;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="C. Diagnostic only (not on the ranking path)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="15" y="865" width="1510" height="95" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Physical model&lt;/b&gt;, tiers 1 and 2 (lumped.py, spatial.py): Sy(z) dz/dt = R − C(z)(z − z&lt;sub&gt;c&lt;/sub&gt;) and 2D Boussinesq; DTM, peat depth, canals by class. Explains why observed water tables are held (supply from outside the rain balance); per-sub-KHG skill 0, frozen." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f7f7f7;strokeColor=#aaaaaa;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="895" width="790" height="55" as="geometry"/></mxCell><mxCell id="c50" value="Retired 2026-10-26: bucket model fitted to SiTMAT (failed spatial skill check); record in docs/bucket_reports/. Not used: TerraClimate (ends 2024-12; only to reproduce 2021), runoff C 0.25 / 0.35 of the 2021 scripts." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f7f7f7;strokeColor=#aaaaaa;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="900" y="895" width="610" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
